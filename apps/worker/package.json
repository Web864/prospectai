{
  "name": "@prospectai/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "maintenance": "tsx --env-file-if-exists=../../.env src/maintenance.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prospectai/ai": "workspace:*",
    "@prospectai/analysis": "workspace:*",
    "@prospectai/crawler": "workspace:*",
    "@prospectai/config": "workspace:*",
    "@prospectai/database": "workspace:*",
    "@prospectai/scoring": "workspace:*",
    "@prospectai/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.19.3"
  }
}
