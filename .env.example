# Required to boot the complete local stack
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_MS=300000
WORKER_RECOVERY_INTERVAL_MS=60000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Required only when using authentication and extension pairing
SESSION_SECRET=replace_with_at_least_32_random_characters
EXTENSION_TOKEN_PEPPER=replace_with_a_separate_32_character_secret

# Required only when using the named integration
OPENAI_API_KEY=your_openai_api_key_here
RESEND_API_KEY=your_resend_api_key_here
STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_test_webhook_secret_here

# Production-only values are provided by the deployment platform, not committed here.
