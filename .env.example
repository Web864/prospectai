# Required to boot the complete local stack
NODE_ENV=development
TRUST_PROXY=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_MS=300000
WORKER_RECOVERY_INTERVAL_MS=60000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Required for authentication, guest sessions, and extension authorization
SESSION_SECRET=replace_with_at_least_32_random_characters
EXTENSION_TOKEN_PEPPER=replace_with_a_separate_32_character_secret
GUEST_SESSION_PEPPER=replace_with_another_32_character_secret
GUEST_ANALYSIS_LIMIT=3
FREE_MONTHLY_ANALYSIS_LIMIT=10
PRO_MONTHLY_ANALYSIS_LIMIT=100
AGENCY_MONTHLY_ANALYSIS_LIMIT=500
GUEST_SESSION_TTL_DAYS=30
GUEST_RESULT_RETENTION_DAYS=30

# Optional provider configuration. Keep placeholders here; put real values only in ignored local env files.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
EMAIL_PROVIDER=development
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=your_stripe_pro_price_id_here
STRIPE_AGENCY_PRICE_ID=your_stripe_agency_price_id_here

# Production-only values are provided by the deployment platform, not committed here.
